---
import { siteConfig } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // Absolute URL. Optional — most pages (calculator, About, FAQ...) have
  // no dedicated image and just omit it; blog posts pass their hero image.
  image?: string;
}

const { title, description, image } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();

// Google Consent Mode v2, split across two `set:html` scripts so the
// literal JS text — not an Astro `define:vars` payload — is what lands in
// the static HTML `<script>` tags below (see the <head> comment for why
// that split matters). Every visitor defaults to denied; CookieConsent.astro
// sends the 'update' call once they accept.
const gaConsentDefaultScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
  });
`;
const gaConfigScript = `
  gtag('js', new Date());
  gtag('config', ${JSON.stringify(siteConfig.gaMeasurementId)});
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Pass-through Trusted Types `default` policy, registered before
         any other script runs. Required because the CSP set by
         worker/index.ts includes `require-trusted-types-for 'script'`,
         and both AdSense's and gtag.js's own internal script injection
         ship no Trusted Types policy of their own — this accepts any
         unqualified sink usage the same way the main bytetech247.com
         site's identical policy does. -->
    <script is:inline>
      if (window.trustedTypes?.createPolicy) {
        window.trustedTypes.createPolicy("default", {
          createHTML: (html) => html,
          createScript: (script) => script,
          createScriptURL: (url) => url,
        });
      }
    </script>
    <!-- Google tag (gtag.js), loaded unconditionally and statically —
         not injected via JS after consent — specifically so tools that
         verify GA installation by reading raw page source (rather than
         clicking through the cookie banner) find it. What actually keeps
         this GDPR/UK-consent-compliant is Consent Mode v2: every visitor
         defaults to `denied` on all four signals below, so gtag.js sends
         only anonymous, cookieless pings until CookieConsent.astro's
         Accept handler calls gtag('consent', 'update', ...). Order here
         matters and mirrors Google's own documented Consent Mode
         snippet: the default-consent script must execute before gtag.js's
         async-loaded internals do, so it's placed in its own script tag
         ahead of the <script src> tag rather than combined with the
         'js'/'config' calls after it. `set:html` (not `define:vars`) is
         what's used for the two inline blocks — this needs the literal
         script text in the static HTML for the same source-visibility
         reason the whole tag is static, and `define:vars` doesn't
         guarantee that (see BlogPostLayout.astro's JSON-LD script for
         the same pattern already used elsewhere in this codebase). -->
    {
      siteConfig.gaMeasurementId && (
        <>
          <script is:inline set:html={gaConsentDefaultScript} />
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaMeasurementId}`}
          />
          <script is:inline set:html={gaConfigScript} />
        </>
      )
    }
    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme.
      // No astro:after-swap re-application needed — this is a single
      // static page with no client-side navigation between pages.
      function applyStoredTheme() {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      }
      applyStoredTheme();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="Q7Gw17KC8cG9r4zyeMycGAfPXpAzdGeThLa9evSl-54"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    {image && <meta name="twitter:image" content={image} />}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <CookieConsent />
  </body>
</html>
