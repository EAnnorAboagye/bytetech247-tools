---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";

const title = "Blog | ByteTech247 Tools";
const description =
  "Straight answers about paychecks, taxes, and how this calculator's numbers are actually sourced.";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

// Same UTC pin as BlogPostLayout.astro — see comment there.
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={title} description={description}>
  <main class="content-page">
    <h1>Blog</h1>
    <section>
      <p>
        Straight answers about paychecks, taxes, and exactly where this
        calculator's numbers come from — no filler, every figure sourced.
      </p>
      {
        posts.length === 0 ? (
          <p>New articles are on their way — check back soon.</p>
        ) : (
          <div class="post-grid">
            {posts.map((post) => (
              <Card
                as="a"
                href={`/blog/${post.id}/`}
                padding="none"
                class="post-card"
              >
                <Picture
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  class="post-card__image"
                  widths={[300, 600]}
                  sizes="(min-width: 640px) 300px, 100vw"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                />
                <div class="post-card__body">
                  <h2>{post.data.title}</h2>
                  <p class="post-card__date">
                    {dateFormatter.format(post.data.publishDate)}
                  </p>
                  <p>{post.data.description}</p>
                </div>
              </Card>
            ))}
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: calc(var(--spacing) * 4);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .post-card__image {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    display: block;
  }

  .post-card__body {
    padding: calc(var(--spacing) * 3);
  }

  .post-card h2 {
    font-size: var(--text-lg);
    margin: 0 0 calc(var(--spacing) * 1);
  }

  .post-card__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    margin: 0 0 calc(var(--spacing) * 2);
  }
</style>
