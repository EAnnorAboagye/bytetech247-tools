  <main class="content-page">
    <h1>Page not found</h1>
    <section>
      <p>
        That page doesn't exist. Head back to the <a href="/"
          >Paycheck Calculator</a
        >, or check the <a href="/faq">FAQ</a>.
      </p>
    </section>
  </main>
</BaseLayout>
