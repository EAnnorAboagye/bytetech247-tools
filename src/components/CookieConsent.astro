---
// Opt-in consent gate. Google Analytics no longer loads from here — see
// BaseLayout.astro, which loads gtag.js unconditionally and statically
// (Consent Mode v2, defaulted to denied) so GA-verification tools that
// only read raw page source can find the tag. This component's job for
// GA is just the 'update' call once the visitor actually accepts.
//
// AdSense is different: no script tag exists on the page at all until
// Accept, rather than relying on Consent Mode to gate it — simplest way
// to guarantee no ad script (and no ad cookies) for a visitor who
// rejects, and there's no source-visibility requirement for it the way
// there is for GA.
//
// Dynamically injecting the adsbygoogle.js <script> tag works cleanly
// under this site's CSP specifically because of how 'strict-dynamic' is
// meant to be used: this component's own inline script carries the
// Worker's rotating nonce (every <script> element gets one, see
// worker/index.ts), and a nonce-trusted script is allowed to create
// additional <script> elements via the DOM that inherit that trust
// automatically — no nonce copying needed. This is different from — and
// doesn't repeat — the earlier failure with Cloudflare's Google Tag
// Gateway, which rewrote a *static* <script src> at the edge and lost
// the nonce in the process; nothing here rewrites existing markup, it
// only inserts new elements from a script that was already trusted to
// run.
//
// Setting `.src` on a script element created this way is also a Trusted
// Types sink (`require-trusted-types-for 'script'` in the CSP) — covered
// by the pass-through `default` policy BaseLayout registers first, same
// as the comment there already explains for AdSense's own internal
// script injection.
import { siteConfig } from "../config";
---

<div id="cookie-consent" class="cookie-consent" hidden>
  <p>
    This site uses Google Analytics (and, once approved, Google AdSense) to
    understand traffic and support ads — both are off until you accept. See the <a
      href="/privacy">Privacy Policy</a
    > for details.
  </p>
  <div class="cookie-consent__actions">
    <button
      type="button"
      id="cookie-consent-reject"
      class="cookie-consent__btn cookie-consent__btn--ghost"
    >
      Necessary only
    </button>
    <button
      type="button"
      id="cookie-consent-accept"
      class="cookie-consent__btn cookie-consent__btn--accent"
    >
      Accept
    </button>
  </div>
</div>

<script is:inline define:vars={{ adsenseId: siteConfig.adsensePublisherId }}>
  const STORAGE_KEY = "cookie-consent";

  function grantConsent() {
    if (typeof window.gtag === "function") {
      window.gtag("consent", "update", {
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
        analytics_storage: "granted",
      });
    }
  }

  function loadAds() {
    if (!adsenseId) return;
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`;
    script.crossOrigin = "anonymous";
    document.head.appendChild(script);

    window.addEventListener("load", () => {
      const unfilled = document.querySelectorAll(
        "ins.adsbygoogle:not([data-adsbygoogle-status])",
      );
      for (let i = 0; i < unfilled.length; i++) {
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch {
          // Ad script blocked (ad blocker, offline) — every slot's
          // reserved min-height keeps layout stable either way.
        }
      }
    });
  }

  const banner = document.getElementById("cookie-consent");
  const stored = localStorage.getItem(STORAGE_KEY);

  if (stored === "accepted") {
    grantConsent();
    loadAds();
  } else if (stored !== "rejected") {
    banner.hidden = false;
  }

  document
    .getElementById("cookie-consent-accept")
    ?.addEventListener("click", () => {
      localStorage.setItem(STORAGE_KEY, "accepted");
      banner.hidden = true;
      grantConsent();
      loadAds();
    });

  document
    .getElementById("cookie-consent-reject")
    ?.addEventListener("click", () => {
      localStorage.setItem(STORAGE_KEY, "rejected");
      banner.hidden = true;
    });
</script>

<style>
  .cookie-consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 3);
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    background: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-card-hover);
  }

  .cookie-consent p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    max-width: 40rem;
  }

  .cookie-consent__actions {
    display: flex;
    gap: calc(var(--spacing) * 2);
    flex-shrink: 0;
  }

  .cookie-consent__btn {
    font-size: var(--text-sm);
    font-weight: 600;
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    cursor: pointer;
  }

  .cookie-consent__btn--ghost {
    background: transparent;
    color: var(--color-fg-muted);
  }

  .cookie-consent__btn--accent {
    background: var(--color-accent);
    color: var(--color-accent-fg);
    border-color: transparent;
  }
</style>
