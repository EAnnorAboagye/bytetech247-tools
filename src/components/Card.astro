---
import { cva, type VariantProps } from "class-variance-authority";

const card = cva(
  "rounded-lg border border-border bg-bg-subtle overflow-hidden shadow-card transition-[transform,box-shadow,border-color] duration-200 ease-out motion-reduce:transition-none hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-card-hover",
  {
    variants: {
      padding: {
        none: "",
        sm: "p-2",
        md: "p-4",
      },
    },
    defaultVariants: { padding: "md" },
  },
);

// Record<string, unknown> lets callers pass through arbitrary attributes
// (e.g. href when as="a") — needed now that Card has its first real
// consumer using it as a link, not just a div.
type Props = VariantProps<typeof card> & {
  as?: string;
  class?: string;
} & Record<string, unknown>;
const { padding, as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag class:list={[card({ padding }), className]} {...rest}>
  <slot />
</Tag>
