---
// Full site nav (including Privacy, deliberately left out of Header's
// primary nav — legal links live in the footer by convention) plus the
// disclaimer and contact address every page should carry.
import { siteConfig } from "../config";

const year = new Date().getFullYear();
const footerLinks = [...siteConfig.nav, { href: "/privacy", label: "Privacy" }];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav class="site-footer__nav" aria-label="Footer">
      {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <p class="site-footer__disclaimer">
      {siteConfig.name} provides estimates for informational purposes only — not tax
      or financial advice. Verify anything consequential with a CPA or the IRS directly.
    </p>

    <p class="site-footer__meta">
      {`© ${year} ${siteConfig.name} · `}<a
        href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a
      >
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: calc(var(--spacing) * 10);
  }

  .site-footer__inner {
    max-width: 64rem;
    margin-inline: auto;
    padding: calc(var(--spacing) * 6) calc(var(--spacing) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 4);
  }

  .site-footer__nav a {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-footer__disclaimer {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 42rem;
    margin: 0;
  }

  .site-footer__meta {
    color: var(--color-fg-muted);
    font-size: var(--text-xs);
    margin: 0;
  }

  .site-footer__meta a {
    color: var(--color-fg-muted);
  }
</style>
